{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "packages/*/src/**/*",
    "vitest.setup.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "examples/*/src/**/*",
    "examples/playground/vite.config.ts",
    "examples/playground/e2e/**/*",
    "tools/**/*.ts"
  ]
}
