<Project>

  <PropertyGroup Condition="'$(IsAotCompatible)' == 'true'">
    <ReeveWorkflowTrimAndAotDiagnostics>
      IL2001;IL2002;IL2003;IL2004;IL2005;IL2006;IL2007;IL2008;IL2009;IL2010;IL2011;IL2012;
      IL2013;IL2014;IL2015;IL2016;IL2017;IL2018;IL2019;IL2020;IL2021;IL2022;IL2023;IL2024;
      IL2025;IL2026;IL2027;IL2028;IL2029;IL2030;IL2031;IL2032;IL2033;IL2034;IL2035;IL2036;
      IL2037;IL2038;IL2039;IL2040;IL2041;IL2042;IL2043;IL2044;IL2045;IL2046;IL2047;IL2048;
      IL2049;IL2050;IL2051;IL2052;IL2053;IL2054;IL2055;IL2056;IL2057;IL2058;IL2059;IL2060;
      IL2061;IL2062;IL2063;IL2064;IL2065;IL2066;IL2067;IL2068;IL2069;IL2070;IL2071;IL2072;
      IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2079;IL2080;IL2081;IL2082;IL2083;IL2084;
      IL2085;IL2086;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2096;
      IL2097;IL2098;IL2099;IL2100;IL2101;IL2102;IL2103;IL2104;IL2105;IL2106;IL2107;IL2108;
      IL2109;IL2110;IL2111;IL2112;IL2113;IL2114;IL2115;IL2116;IL2117;IL2118;IL2119;IL2120;
      IL2121;IL2122;IL2123;IL2124;IL2125;IL3000;IL3001;IL3002;IL3003;IL3050;IL3051;IL3052;
      IL3053;IL3054;IL3055;IL3056;IL3057;IL3058;SYSLIB1030;SYSLIB1031;SYSLIB1032;SYSLIB1033;SYSLIB1034;SYSLIB1035;
      SYSLIB1036;SYSLIB1037;SYSLIB1038;SYSLIB1039;SYSLIB1220;SYSLIB1221;SYSLIB1222;SYSLIB1223;SYSLIB1224;SYSLIB1225;SYSLIB1226;SYSLIB1227;
      SYSLIB1228;SYSLIB1229
    </ReeveWorkflowTrimAndAotDiagnostics>
    <WarningsAsErrors>$(WarningsAsErrors);$([System.Text.RegularExpressions.Regex]::Replace('$(ReeveWorkflowTrimAndAotDiagnostics)', '\s', ''))</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReeveWorkflow.Abstractions'">
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReeveWorkflow.Core'">
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <WorkflowAllowedPackageReference Include="Polly.Core" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReeveWorkflow.DependencyInjection'">
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReeveWorkflow.Blocks'">
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.Abstractions" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.Core" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReeveWorkflow.EntityFrameworkCore'">
    <WorkflowAllowedPackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.Core" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.DependencyInjection" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReeveWorkflow.EntityFrameworkCore.PostgreSql'">
    <WorkflowAllowedPackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <WorkflowAllowedPackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <WorkflowAllowedPackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <WorkflowAllowedPackageReference Include="CmdScale.EntityFrameworkCore.TimescaleDB" />
    <WorkflowAllowedPackageReference Include="CmdScale.EntityFrameworkCore.TimescaleDB.Design" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.EntityFrameworkCore" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.DependencyInjection" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReeveWorkflow.History'">
    <WorkflowAllowedPackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.Options" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReeveWorkflow.Debug'">
    <WorkflowAllowedPackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.Options" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReeveWorkflow.Redis'">
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <WorkflowAllowedPackageReference Include="StackExchange.Redis" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.Core" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.DependencyInjection" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReeveWorkflow.Npgsql'">
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <WorkflowAllowedPackageReference Include="Npgsql" />
    <WorkflowAllowedPackageReference Include="Reeve.EntityFrameworkCore.AdvisoryLocks" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.Core" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.DependencyInjection" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReeveWorkflow.AspNetCore'">
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.Core" />
    <WorkflowAllowedFrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReeveWorkflow.Editor'">
    <WorkflowAllowedPackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <WorkflowAllowedPackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.EntityFrameworkCore" />
    <WorkflowAllowedSiblingProjectReference Include="ReeveWorkflow.DependencyInjection" />
    <WorkflowAllowedFrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <WorkflowEnforceClosure>true</WorkflowEnforceClosure>
  </PropertyGroup>

  <Target Name="WorkflowReadDeclaredProjectReferences"
          BeforeTargets="BeforeBuild;CoreCompile"
          Condition="'$(WorkflowEnforceClosure)' == 'true'">
    <XmlPeek XmlInputPath="$(MSBuildProjectFullPath)"
             Query="//ProjectReference/@Include">
      <Output TaskParameter="Result" ItemName="_WorkflowDeclaredProjectReferencePath" />
    </XmlPeek>
    <ItemGroup>
      <WorkflowDeclaredProjectReference
        Include="$([System.IO.Path]::GetFileNameWithoutExtension('%(_WorkflowDeclaredProjectReferencePath.Identity)'))" />
    </ItemGroup>
  </Target>

  <Target Name="WorkflowEnforceDeclaredPackageReferences"
          BeforeTargets="BeforeBuild"
          Condition="'@(WorkflowAllowedPackageReference)' != ''">
    <ItemGroup>
      <_WorkflowExplicitPackageReference Include="@(PackageReference)"
                                         Condition="'%(PackageReference.IsImplicitlyDefined)' != 'true' Or '%(PackageReference.PrivateAssets)' != 'all'" />
      <_WorkflowUndeclaredPackage Include="@(_WorkflowExplicitPackageReference->'%(Identity)')"
                                  Exclude="@(WorkflowAllowedPackageReference)" />
    </ItemGroup>
    <Error Condition="'@(_WorkflowUndeclaredPackage)' != ''"
           Code="RW0001"
           Text="Dependency violation: $(MSBuildProjectName) references the package @(_WorkflowUndeclaredPackage, ', '), which is not in its declared set (@(WorkflowAllowedPackageReference, ', ')). This package's whole reason to exist is that its dependency list stays this short; widening it needs an argument, made by editing the list in dotnet/Directory.Build.targets." />
  </Target>

  <Target Name="WorkflowEnforceSelfContainedPackage"
          AfterTargets="WorkflowReadDeclaredProjectReferences"
          BeforeTargets="BeforeBuild"
          Condition="'$(WorkflowEnforceClosure)' == 'true'">
    <ItemGroup>
      <_WorkflowForbiddenProjectReference Include="@(WorkflowDeclaredProjectReference)"
                                          Exclude="@(WorkflowAllowedSiblingProjectReference)" />
      <_WorkflowExtraFrameworkReference Include="@(FrameworkReference)" Exclude="Microsoft.NETCore.App" />
      <_WorkflowExtraFrameworkReference Remove="@(WorkflowAllowedFrameworkReference)" />
    </ItemGroup>

    <Error Condition="'@(_WorkflowForbiddenProjectReference)' != ''"
           Code="RW0002"
           Text="Closure violation: $(MSBuildProjectName) project-references @(_WorkflowForbiddenProjectReference, ', '), which is not a package published beside it. In a restore that edge is a package edge, so it must name a sibling listed in WorkflowAllowedSiblingProjectReference or not exist." />

    <Error Condition="'@(_WorkflowExtraFrameworkReference)' != ''"
           Code="RW0003"
           Text="Closure violation: $(MSBuildProjectName) declares FrameworkReference @(_WorkflowExtraFrameworkReference, ', '), which is not in its declared set (@(WorkflowAllowedFrameworkReference, ', ')). Only the two API packages may bring a web framework in." />
  </Target>

</Project>
