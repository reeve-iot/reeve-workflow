<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>ReeveWorkflow.Abstractions</PackageId>
    <Description>The workflow block SDK: what a block declares, what it is handed when it runs, and how a run is started. One dependency, so a block author's closure is one package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReeveWorkflow.Core" />
    <InternalsVisibleTo Include="ReeveWorkflow.Blocks" />
    <InternalsVisibleTo Include="ReeveWorkflow.Blocks.Tests" />
    <InternalsVisibleTo Include="ReeveWorkflow.Core.Tests" />
  </ItemGroup>

</Project>
