<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>ReeveWorkflow.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core persistence for the workflow engine: the nine tables it owns. Takes no dependency on TimescaleDB; running without it is supported.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReeveWorkflow.DependencyInjection\ReeveWorkflow.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReeveWorkflow.Editor" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReeveWorkflow.History" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReeveWorkflow.EntityFrameworkCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReeveWorkflow.Core\ReeveWorkflow.Core.csproj" />
  </ItemGroup>

</Project>
