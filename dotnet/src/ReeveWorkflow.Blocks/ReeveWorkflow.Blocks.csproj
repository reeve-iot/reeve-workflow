<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>ReeveWorkflow.Blocks</PackageId>
    <Description>The blocks every workflow host ends up writing: branches, loops, Try/Catch, conversions, arithmetic, JSON and an HTTP call. Opt-in, and any one of them is replaceable by name.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReeveWorkflow.Abstractions\ReeveWorkflow.Abstractions.csproj" />
    <ProjectReference Include="..\ReeveWorkflow.Core\ReeveWorkflow.Core.csproj" />
  </ItemGroup>

</Project>
