<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>ReeveWorkflow.Core</PackageId>
    <Description>The workflow engine: the expression language a definition is written in, and the machinery that evaluates it. Depends on no dependency-injection container.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReeveWorkflow.Abstractions\ReeveWorkflow.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReeveWorkflow.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReeveWorkflow.Blocks" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReeveWorkflow.Editor" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReeveWorkflow.Blocks.Tests" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReeveWorkflow.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReeveWorkflow.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReeveWorkflow.AspNetCore" />
    <InternalsVisibleTo Include="ReeveWorkflow.Editor" />
  </ItemGroup>

</Project>
